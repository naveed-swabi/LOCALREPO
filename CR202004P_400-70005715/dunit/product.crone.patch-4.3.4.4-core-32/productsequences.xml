<?xml version="1.0"?>
<productSequences>
  <productSequence>
    <action id="DetectAdminPrivilege">
      <arg name="Property" value="AdminPrivilege"/>
    </action>
    <productSequence>
      <condition property="AdminPrivilege" value="false"/>
      <property id="SharedAlwaysFailureMessage" value="#Failure.Because.No.Administrative.Privilege#"/>
      <dialogRef2 id="SharedAlwaysFailure.dialog"/>
    </productSequence>
    <property id="PerUserInstall" value="false"/>
    <action id="RegistrySearch">
      <arg name="RegistryKey" value="HKEY_LOCAL_MACHINE\SOFTWARE\SAP BusinessObjects\Suite XI 4.0\Installer\Aurora"/>
      <arg name="RegistryName" value="path"/>
      <arg name="RegistryType" value="0"/>
      <arg name="PropertyName" value="InstallDirFromRegistry"/>
    </action>
    <branch>
      <productSequence>
        <condition isset="InstallDirFromRegistry"/>
        <property id="IsRootDirFinalized" value="true"/>
        <property id="InstallDir" value="[InstallDirFromRegistry]"/>
      </productSequence>
      <productSequence>
        <condition>
          <not>
            <condition isset="InstallDir"/>
          </not>
        </condition>
        <action id="ProductOSDefaultInstallLocation">
          <arg name="PerUserInstall" value="[PerUserInstall]"/>
          <arg name="PropertyName" value="InstallDir"/>
        </action>
      </productSequence>
    </branch>
  </productSequence>
  <productSequence>
    <action id="SetWindowsSystemFolderProps"/>
    <branch>
      <productSequence>
        <condition property="$InstallMode" value="new"/>
        <branch>
          <productSequence>
            <action id="GetProductPatchLevel">
              <arg name="ProductDUID" value="product.crystalreports-4.0-core-32"/>
              <arg name="ProductFamilyDUID" value="product.crystalreports.productfamilyid-4.0-core-nu"/>
              <arg name="PropertyName" value="CurrentPatchLevel"/>
            </action>
            <action id="CompareVersion">
              <arg name="maxVersion" value="14.3.0.0"/>
              <arg name="minVersion" value=""/>
              <arg name="VersionNeedToCompare" value="[$du$product.crystalreports.productfamilyid-4.0-core-nu$installedRevision]"/>
              <arg name="Property" value="CurrentInstalledProductBelow43_SP0"/>
            </action>
            <action id="DetectOverhangingPatch">
              <arg name="CurrentPatchLevel" value="[CurrentPatchLevel]"/>
            </action>
            <productSequence>
              <condition property="OverhangingPatch" value="true"/>
              <dialogRef2 id="ShowMessageSimple.dialog">
                <arg name="DialogType" value="warning"/>
                <arg name="UnformattedMessage" value="#OverhangingPatchMessage#"/>
              </dialogRef2>
              <property id="CheckPreRequisiteRetry" value="false"/>
            </productSequence>
            <action id="CompareVersion">
              <arg name="maxVersion" value="14.0.3.613"/>
              <arg name="minVersion" value="14.0.0.760"/>
              <arg name="VersionNeedToCompare" value="[CurrentPatchLevel]"/>
              <arg name="Property" value="product.shared.acceleratemsioperations-4.0-core$RunAccelerateMsiOperations"/>
            </action>
          </productSequence>
        </branch>
        <action id="CompareVersion">
          <arg name="maxVersion" value="14.3.2.0"/>
          <arg name="minVersion" value=""/>
          <arg name="VersionNeedToCompare" value="[$du$product.crystalreports.productfamilyid-4.0-core-nu$installedRevision]"/>
          <arg name="Property" value="CurrentInstalledVersionBelowSpecifiedVersion"/>
        </action>
        <dialogRef2 id="CheckPreRequisites.dialog"/>
        <action id="CheckForBlockingProductPreReqs"/>
        <branch>
          <productSequence>
            <condition property="HasBlockingPreReq" value="1"/>
            <property id="SharedAlwaysFailureMessage" value="#Failure.Because.Critical.PreReq.Does.Not.Pass#"/>
            <dialogRef2 id="SharedAlwaysFailure.dialog"/>
          </productSequence>
        </branch>
        <dialogRef2 id="ShowWelcomeScreen.dialog"/>
        <dialogRef2 id="ShowLicenseAgreement.dialog"/>
        <branch>
          <productSequence>
            <condition property="CurrentInstalledProductBelow43_SP0" value="1"/>
            <dialogRef2 id="ShowPatchLicenseInfoCR2020.dialog"/>
          </productSequence>
        </branch>
        <branch>
          <productSequence>
            <condition>
              <and>
                <condition property="$isSilent" value="true"/>
                <condition property="CurrentInstalledProductBelow43_SP0" value="1"/>
              </and>
            </condition>
            <dialogRef2 id="CREnterProductKey.dialog">
              <validatorRef id="ValidateProductKey" severity="warn" errormsg="#Invalid_ProductKey#" waitMsg="">
                <arg name="ProductKey" value="[ProductKey]"/>
                <arg name="KeyTypes" value="CR.EnableCR:143"/>
              </validatorRef>
            </dialogRef2>
          </productSequence>
        </branch>
        <dialogRef2 id="SelectLanguagePack.dialog"/>
        <dialogRef2 id="ShowInstallSummary.dialog"/>
      </productSequence>
      <productSequence>
        <condition property="$InstallMode" value="maintenance"/>
        <dialogRef2 id="VerifyToRemove.dialog">
          <arg name="DialogArgument" value="ARPRemove"/>
        </dialogRef2>
        <action id="ChangeFeatureState">
          <arg name="FeatureID" value="root"/>
          <arg name="State" value="Uninstall"/>
        </action>
      </productSequence>
    </branch>
    <productSequence>
      <action id="CompareVersion">
        <arg name="maxVersion" value="14.2.0.0"/>
        <arg name="minVersion" value=""/>
        <arg name="VersionNeedToCompare" value="[$du$shared.tp.aurora.datadirect.cpp-4.0-core-32$installedRevision]"/>
        <arg name="Property" value="DataDirect_DU_Below_4_2"/>
      </action>
      <condition>
        <or>
          <condition property="$du$shared.tp.aurora.datadirect.cpp-4.0-core-32$installing" value=""/>
          <condition property="$du$shared.tp.aurora.datadirect.cpp.optional-4.0-core-32$installing" value=""/>
        </or>
      </condition>
      <property id="DataDirect7Installed" value="true"/>
    </productSequence>
  </productSequence>
  <productSequence>
    <productSequence>
      <condition>
        <and>
          <condition property="DataDirect7Installed" value="true"/>
          <condition property="DataDirect_DU_Below_4_2" value="1"/>
        </and>
      </condition>
      <property id="PostInstallMessage" value="[PostInstallMessage]_!!_#postInstall.message.datadirect#"/>
    </productSequence>
    <productSequence>
      <condition>
        <and>
          <not>
            <condition property="PostInstallMessage" value=""/>
          </not>
          <condition property="$InstallMode" value="new"/>
          <condition property="$wasCanceled" value="false"/>
        </and>
      </condition>
      <dialogRef2 id="ShowPostInstall.dialog"/>
      <property id="PostInstallMessageDialogIsShown" value="yes"/>
      <property id="ShowInstallCompleteBackButton" value="true"/>
    </productSequence>
    <branch>
      <productSequence>
        <condition>
          <and>
            <condition property="$isSilent" value="true"/>
            <condition property="CurrentInstalledProductBelow43_SP0" value="1"/>
          </and>
        </condition>
        <action id="RunCommand" actionText="">
          <arg name="CmdLine" value="cmd /c &quot;cd &quot;[InstallDir]SAP BusinessObjects Enterprise XI 4.0\win64_x64&quot; &amp;&amp; echo f | &quot;RegisterKeycode.exe&quot; &quot;[ProductKey]&quot; &quot;SOFTWARE\\SAP BusinessObjects\\Suite XI 4.0\\Crystal Reports\\Keycodes\\CR Dev&quot;&quot;"/>
          <arg name="LogCmdLine" value="yes"/>
          <arg name="SensitiveData" value="[ProductKey]"/>
        </action>
      </productSequence>
    </branch>
    <branch>
      <productSequence>
        <condition>
          <and>
            <condition property="$InstallMode" value="new"/>
            <condition property="$wasCanceled" value="false"/>
          </and>
        </condition>
        <dialogRef2 id="ShowInstallComplete.dialog">
          <arg name="EnableBackButton" value="[ShowInstallCompleteBackButton]"/>
        </dialogRef2>
      </productSequence>
      <productSequence>
        <condition property="$InstallMode" value="maintenance"/>
        <dialogRef2 id="ShowUninstallComplete.dialog"/>
      </productSequence>
    </branch>
  </productSequence>
